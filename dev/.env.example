# Copy this file to dev/.env and fill in your CachyOS test machine's details.
# dev/.env is gitignored so your host details never get committed.

HTPC_DEV_HOST=user@catchyos.local

# Relative to the remote user's home directory. Do not use "~" here: this
# file is sourced locally, so "~" would expand to your local home directory
# instead of the remote one before rsync ever sees it.
HTPC_DEV_PATH=catchy-htpc-dev
