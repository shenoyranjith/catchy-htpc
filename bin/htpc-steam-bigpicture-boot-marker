#!/usr/bin/env bash
# Run as htpc-desktop.service's own ExecStartPre (`-` prefixed there, so
# any failure here is ignored rather than blocking Plasma from starting).
#
# Only meaningful on NVIDIA, where this Plasma session backs both Desktop
# Mode and Steam Gaming Mode (nested gamescope + Steam Deck UI), told apart
# by HTPC_STEAM_BIGPICTURE in /run/cachyos-htpc/environment.
#
# htpc-switch always writes that marker before starting/toggling this
# session. The only time it is absent is a cold boot -- derive it from
# BOOT_SESSION so booting into "steam" launches Deck UI via autostart.

set -uo pipefail

HTPC_GPU_VENDOR_FILE="/etc/cachyos-htpc/gpu-vendor"
HTPC_STEAM_BIGPICTURE_ENV="/run/cachyos-htpc/environment"
HTPC_INSTALL_RECORD_PATH="/var/lib/cachyos-htpc/install-record"

[[ -r "${HTPC_GPU_VENDOR_FILE}" ]] || exit 0
[[ "$(cat "${HTPC_GPU_VENDOR_FILE}")" == "nvidia" ]] || exit 0
[[ -f "${HTPC_STEAM_BIGPICTURE_ENV}" ]] && exit 0

boot_session="desktop"
if [[ -r "${HTPC_INSTALL_RECORD_PATH}" ]]; then
    value="$(sed -n 's|^BOOT_SESSION=||p' "${HTPC_INSTALL_RECORD_PATH}" | tail -n1)"
    [[ -n "${value}" ]] && boot_session="${value}"
fi

if [[ "${boot_session}" == "steam" ]]; then
    printf 'HTPC_STEAM_BIGPICTURE=1\n' > "${HTPC_STEAM_BIGPICTURE_ENV}"
else
    printf 'HTPC_STEAM_BIGPICTURE=0\n' > "${HTPC_STEAM_BIGPICTURE_ENV}"
fi
