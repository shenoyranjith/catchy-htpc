#!/usr/bin/env bash
# KDE autostart entry for NVIDIA's merged Steam Gaming Mode / KDE Desktop
# session. Runs once when htpc-desktop.service's Plasma session starts.
#
# On NVIDIA, "Desktop Mode" and "Steam Gaming Mode" share this Plasma
# session. Gaming Mode launches nested gamescope + Steam Deck UI via
# /usr/local/bin/htpc-steamdeck-launch (Steam must not already be running).
# Desktop Mode starts the normal Steam desktop client.
#
# Switching between the two while Plasma is already up is handled by
# htpc-switch in-process (see its header), not by this script.

set -uo pipefail

HTPC_STEAM_BIGPICTURE_ENV="/run/cachyos-htpc/environment"
if [[ -f "${HTPC_STEAM_BIGPICTURE_ENV}" ]]; then
    # shellcheck disable=SC1090
    source "${HTPC_STEAM_BIGPICTURE_ENV}"
fi
export HTPC_STEAM_BIGPICTURE="${HTPC_STEAM_BIGPICTURE:-0}"

if [[ "${HTPC_STEAM_BIGPICTURE}" == "1" ]]; then
    echo "htpc-steam-autostart: Steam Gaming Mode; launching nested gamescope Steam Deck UI." >&2
    if [[ -x /usr/local/bin/htpc-steamdeck-launch ]]; then
        nohup /usr/local/bin/htpc-steamdeck-launch --start >/dev/null 2>&1 &
        disown
    else
        echo "htpc-steam-autostart: htpc-steamdeck-launch missing." >&2
    fi
else
    echo "htpc-steam-autostart: Desktop Mode; starting Steam normally." >&2
    nohup /usr/bin/steam >/dev/null 2>&1 &
    disown
fi
