#!/usr/bin/env bash
set -euo pipefail

# Session Manager. Switches between the three htpc-*.service session units,
# enforcing the transition rules in session-lifecycle.md and applying the
# recovery rules if the destination session fails to start. See
# session-manager-spec.md.
#
# Runs as the existing user (not root). A polkit rule installed alongside
# this script grants passwordless start/stop/restart of only the three
# htpc-*.service units, so no sudo is needed here. If invoked as root (e.g.
# via the pkexec-authorized steamos-session-select wrapper), it re-execs
# itself as the existing user before doing anything else.
#
# htpc-switch is commonly invoked from *within* the session being switched
# away from: a future Kodi add-on, or Steam's own "Switch to Desktop"
# button (via the steamos-session-select wrapper). If this script stopped
# the current htpc-*.service inline, systemd would send SIGTERM to that
# unit's whole cgroup as part of the stop -- including htpc-switch itself,
# since it's a descendant process of that same session -- killing it before
# it could start the destination session. To avoid this, the actual
# stop-current/start-target work is always dispatched to a detached
# transient --user unit (systemd-run --user), which lives in a completely
# separate cgroup (under user@<uid>.service) and is unaffected by the old
# session's teardown. Validation (invalid transition, already running,
# failure to even dispatch) is still reported synchronously to the caller.
#
# Self-contained by design: this script is installed standalone to
# /usr/local/bin and must keep working even if the project's repo checkout
# it was installed from is no longer present.
#
# Usage:
#   htpc-switch kodi
#   htpc-switch steam
#   htpc-switch desktop

htpc_log() {
    local level="$1"
    shift
    local message="$*"

    case "${level}" in
        ERROR|WARN)
            printf '[%s] %s\n' "${level}" "${message}" >&2
            ;;
        *)
            printf '[%s] %s\n' "${level}" "${message}"
            ;;
    esac

    if command -v logger >/dev/null 2>&1; then
        logger -t cachyos-htpc -- "${level}: ${message}" || true
    fi
}

htpc_log_info()  { htpc_log "INFO" "$@"; }
htpc_log_error() { htpc_log "ERROR" "$@"; }

declare -A HTPC_SESSION_UNIT=(
    [kodi]="htpc-kodi.service"
    [steam]="htpc-steam.service"
    [desktop]="htpc-desktop.service"
)

# Prints the name of the currently active session, or "boot" if none of the
# htpc-*.service units are active (matching the Boot state in
# session-lifecycle.md).
htpc_current_session() {
    local name unit
    for name in "${!HTPC_SESSION_UNIT[@]}"; do
        unit="${HTPC_SESSION_UNIT[${name}]}"
        if systemctl is-active --quiet "${unit}"; then
            printf '%s\n' "${name}"
            return 0
        fi
    done
    printf 'boot\n'
}

# Returns success if switching from $1 to $2 is a valid transition per
# session-lifecycle.md. Boot -> desktop exists in the lifecycle but is a
# boot-time fallback only, not a user-facing command, so it is intentionally
# excluded here.
htpc_transition_valid() {
    local from="$1" to="$2"
    case "${from}:${to}" in
        boot:kodi) return 0 ;;
        kodi:steam|kodi:desktop) return 0 ;;
        steam:kodi|steam:desktop) return 0 ;;
        desktop:kodi|desktop:steam) return 0 ;;
        *) return 1 ;;
    esac
}

htpc_start_getty_fallback() {
    htpc_log_error "Entering Fatal Error: falling back to a plain TTY login on tty1."
    systemctl start getty@tty1.service || htpc_log_error "Failed to start getty@tty1.service."
}

# Starts the given unit and confirms it actually reached the active state.
htpc_try_start() {
    local unit="$1"
    htpc_log_info "Starting ${unit}."
    if ! systemctl start "${unit}"; then
        htpc_log_error "systemctl start ${unit} failed."
        return 1
    fi
    if ! systemctl is-active --quiet "${unit}"; then
        htpc_log_error "${unit} did not reach the active state."
        return 1
    fi
    return 0
}

# Starts the destination session, applying the recovery rules in
# session-lifecycle.md if it fails: a failed Kodi or Steam falls back to
# Desktop, and a failed Desktop enters Fatal Error.
htpc_start_with_recovery() {
    local target="$1"

    if htpc_try_start "${HTPC_SESSION_UNIT[${target}]}"; then
        htpc_log_info "Now running ${target}."
        return 0
    fi

    if [[ "${target}" == "desktop" ]]; then
        htpc_start_getty_fallback
        return 1
    fi

    htpc_log_error "${target} failed to start; falling back to desktop."
    if htpc_try_start "${HTPC_SESSION_UNIT[desktop]}"; then
        htpc_log_info "Now running desktop (recovered from failed ${target})."
        return 0
    fi

    htpc_log_error "desktop also failed to start."
    htpc_start_getty_fallback
    return 1
}

# Reaps leaked org.a11y.atspi.Registry transient units. Qt/GTK apps are
# supposed to skip connecting to the accessibility bus entirely given
# NO_AT_BRIDGE=1 (set on all three htpc-*.service units and, for anything
# D-Bus-activated instead, via the environment.d drop-in installed by
# htpc_environment_no_at_bridge_install), but confirmed live that at least
# one trigger -- Steam's Chromium-based UI -- connects anyway regardless.
# Each connection leaves behind a dbus-:N.NN-org.a11y.atspi.Registry@0
# transient unit that is never cleaned up on its own; stopping it here on
# every switch is a guaranteed fix (whatever the cause) rather than a
# best-effort prevention. Harmless if none exist; this unit is worker-only
# and runs as the target user via systemd-run --user, so it already has
# the right XDG_RUNTIME_DIR/D-Bus context for `systemctl --user`.
htpc_cleanup_accessibility_bus() {
    systemctl --user stop 'dbus-*-org.a11y.atspi.Registry@0.service' 2>/dev/null || true
}

# True if a switch dispatched by this script is currently in progress, i.e.
# an htpc-switch-worker-* transient unit (see main()) is still running. Used
# by htpc_exit_fallback below: when the worker calls `systemctl stop` on the
# session it is switching away from, that call does not return until the
# stopped unit's ExecStopPost has finished running, so the worker's own unit
# is guaranteed to still be active for the whole duration of any
# ExecStopPost this script triggers as a side effect of that stop. This
# lets ExecStopPost tell apart "stopped because a deliberate switch is
# already underway" (skip the fallback; that switch already knows where
# it's going) from "stopped on its own, with nothing else driving a switch"
# (run the fallback).
htpc_switch_in_progress() {
    systemctl --user list-units 'htpc-switch-worker-*' --state=active --no-legend --plain 2>/dev/null | grep -q .
}

# True if the system itself is shutting down or rebooting. Confirmed live:
# a reboot/shutdown stops whichever htpc-*.service unit is active as part
# of its own transaction, firing that unit's ExecStopPost exactly like a
# spontaneous exit would -- but at that point user-runtime-dir@<uid>.service
# and the user's own systemd --user manager are themselves already mid-
# teardown (sometimes already gone), so dispatching a fallback switch has
# nothing left to dispatch *to* and reliably fails outright (confirmed:
# `systemd-run --user` errors with "$DBUS_SESSION_BUS_ADDRESS and
# $XDG_RUNTIME_DIR not defined"), or in the worse case actively contends
# with the shutdown transaction that is already tearing that same manager
# down ("Transaction ... is destructive"). Neither outcome is useful --
# the system is on its way down regardless -- so htpc_exit_fallback skips
# itself entirely in this case. "stopping" is systemctl's own documented
# is-system-running state specifically for this (see systemctl(1)).
htpc_system_shutting_down() {
    [[ "$(systemctl is-system-running 2>/dev/null)" == "stopping" ]]
}

# Invoked via ExecStopPost on a session unit: if that session stopped on its
# own (crashed, or was quit from its own UI) rather than as part of an
# already in-flight switch (see htpc_switch_in_progress), dispatches a
# switch to the given fallback target instead of leaving tty1 blank or
# looping back into the session that just stopped. target is normally
# another session name (Kodi/Steam -> desktop), but may also be the
# internal pseudo-target "fatal" (Desktop -> Fatal Error; see
# htpc_worker_main). Bypasses htpc_transition_valid by calling the worker
# directly with current=boot (accurate: the stopping session has, by this
# point, already fully stopped), the same way main() would after
# validating a user-facing command -- this path has no user-facing command
# to validate in the first place, so there is nothing to bypass unsafely.
htpc_exit_fallback() {
    local target="$1"

    if htpc_system_shutting_down; then
        htpc_log_info "System is shutting down; skipping exit fallback to ${target}."
        return 0
    fi

    if htpc_switch_in_progress; then
        htpc_log_info "Switch already in progress; skipping exit fallback to ${target}."
        return 0
    fi

    if [[ "$(htpc_current_session)" == "${target}" ]]; then
        return 0
    fi

    htpc_log_info "Session stopped on its own; falling back to ${target}."
    if ! systemd-run --user --collect --quiet \
        --unit="htpc-switch-worker-$$" \
        /usr/local/bin/htpc-switch --worker boot "${target}"; then
        htpc_log_error "Failed to dispatch exit fallback to ${target}."
    fi
}

# Performs the actual switch: stopping the current session's unit (if any)
# and starting the destination with recovery. Only ever run detached, via
# systemd-run --user from main(); never called inline. See the file header
# for why.
#
# target may also be the internal pseudo-target "fatal" (only ever reached
# via htpc_exit_fallback, with current always "boot" -- see that function):
# Desktop stopping on its own with nothing left to fall back to, per the
# Fatal Error rules in session-lifecycle.md. This is not htpc_start_with_
# recovery's own desktop-failed-too fallback (that path already ends in
# Fatal Error directly); it's the boot-time/self-exit equivalent for when
# Desktop itself was the one that just stopped.
htpc_worker_main() {
    local current="$1" target="$2"

    if [[ "${current}" != "boot" ]]; then
        htpc_log_info "Stopping ${HTPC_SESSION_UNIT[${current}]}."
        systemctl stop "${HTPC_SESSION_UNIT[${current}]}" \
            || htpc_log_error "Failed to stop ${HTPC_SESSION_UNIT[${current}]} cleanly; continuing."
        # Run now, not after starting the target: the session just stopped
        # has had its whole lifetime to leak one, so there is no race,
        # unlike checking right after starting the *new* one (which may not
        # have connected yet).
        htpc_cleanup_accessibility_bus
    fi

    if [[ "${target}" == "fatal" ]]; then
        htpc_start_getty_fallback
        return
    fi

    if ! htpc_start_with_recovery "${target}"; then
        exit 1
    fi
}

# Prints the user the htpc-*.service units are configured to run as, by
# reading it back from the already-installed htpc-kodi.service unit. Used
# to drop root privileges when invoked as root (e.g. via pkexec from the
# steamos-session-select wrapper).
htpc_configured_user() {
    systemctl show -p User --value "${HTPC_SESSION_UNIT[kodi]}"
}

usage() {
    echo "Usage: $(basename "$0") {kodi|steam|desktop}" >&2
}

main() {
    if [[ "${1:-}" == "--worker" ]]; then
        shift
        htpc_worker_main "$@"
        return
    fi

    if [[ "${1:-}" == "--exit-fallback" ]]; then
        shift
        htpc_exit_fallback "$@"
        return
    fi

    if [[ "$(id -u)" -eq 0 ]]; then
        local configured_user
        configured_user="$(htpc_configured_user)"
        if [[ -z "${configured_user}" ]]; then
            htpc_log_error "Running as root and could not determine the configured user; aborting."
            exit 1
        fi
        exec runuser -u "${configured_user}" -- "$0" "$@"
    fi

    local target="${1:-}"
    if [[ -z "${target}" || -z "${HTPC_SESSION_UNIT[${target}]+x}" ]]; then
        usage
        exit 1
    fi

    local current
    current="$(htpc_current_session)"

    if [[ "${current}" == "${target}" ]]; then
        htpc_log_error "Already running ${target}; nothing to do."
        exit 1
    fi

    if ! htpc_transition_valid "${current}" "${target}"; then
        htpc_log_error "Invalid transition: ${current} -> ${target}."
        exit 1
    fi

    htpc_log_info "Dispatching switch ${current} -> ${target}."
    if ! systemd-run --user --collect --quiet \
        --unit="htpc-switch-worker-$$" \
        /usr/local/bin/htpc-switch --worker "${current}" "${target}"; then
        htpc_log_error "Failed to dispatch session switch."
        exit 1
    fi
}

main "$@"
