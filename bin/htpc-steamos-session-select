#!/usr/bin/env bash
set -euo pipefail

# Thin replacement for gamescope-session-cachyos's own
# /usr/bin/steamos-session-select. See session-services-spec.md.
#
# On AMD (exclusive gamescope session), "plasma" returns to Kodi (primary
# interface). On NVIDIA (Deck UI nested in Plasma), "plasma" returns to
# Desktop Mode in that same Plasma session -- closing gamescope, not
# leaving for Kodi.

usage() {
    cat >&2 <<EOF
Usage: $(basename "$0") <mode>

Modes:
  plasma      NVIDIA: KDE Desktop Mode (same Plasma session).
              AMD: primary interface (Kodi).
  gamescope   Switch to Steam Gaming Mode.
  persistent  No-op (SDDM autologin behaviour; not applicable here).
  oneshot     No-op (SDDM autologin behaviour; not applicable here).
EOF
}

htpc_gpu_is_nvidia() {
    local vendor_file="/etc/cachyos-htpc/gpu-vendor"
    [[ -r "${vendor_file}" ]] && [[ "$(cat "${vendor_file}")" == "nvidia" ]]
}

case "${1:-}" in
    plasma)
        if htpc_gpu_is_nvidia; then
            exec /usr/local/bin/htpc-switch desktop
        else
            exec /usr/local/bin/htpc-switch kodi
        fi
        ;;
    gamescope)
        exec /usr/local/bin/htpc-switch steam
        ;;
    persistent|oneshot)
        exit 0
        ;;
    *)
        [[ -n "${1:-}" ]] && echo "Unknown session '$1'" >&2
        usage
        exit 1
        ;;
esac
