[Unit]
Description=catchy-htpc - Kodi session
After=systemd-user-sessions.service getty@tty1.service plymouth-quit-wait.service sound.target
Conflicts=getty@tty1.service htpc-steam.service htpc-desktop.service

[Service]
Type=simple
User=__HTPC_USER__
# Kodi's GBM windowing opens /dev/input/event* directly via libinput rather
# than acquiring them through logind's D-Bus device hand-off (the mechanism
# KDE/gamescope use), so it needs real group access to read them. Granted
# here rather than via a persistent usermod so it only applies to this
# session and is fully reverted by removing this unit.
SupplementaryGroups=input render
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=WINDOWING=gbm
# Without this, GTK/Qt components pulled in transitively (codecs, addons)
# each trigger a D-Bus-activated, per-connection at-spi2-registryd instance
# (dbus-:N.NN-org.a11y.atspi.Registry@0.service) that isn't reliably torn
# down again on session switch, leaking one every so often. Confirmed live:
# ~10 accumulated over one afternoon of switching. No accessibility/screen
# reader use case exists on this appliance, so skip the bridge outright.
Environment=NO_AT_BRIDGE=1
ExecStart=/usr/bin/kodi-standalone
# Kodi's own "Exit" quits the whole process cleanly; without a fallback,
# that would strand the user on a blank tty1 with no running session, and
# so would a genuine crash. Restart=no plus ExecStopPost's exit-fallback
# below lands on Desktop in either case instead of relaunching Kodi -- see
# htpc_exit_fallback in htpc-switch. This does not fight a deliberate
# switch away (e.g. Kodi -> Steam via a favourite): htpc-switch's own
# worker stops this unit via systemctl as part of that switch, and does not
# return from that call until this same ExecStopPost has finished running,
# so htpc_switch_in_progress reliably sees that worker still active and
# skips the fallback.
Restart=no
ExecStopPost=/usr/local/bin/htpc-switch --exit-fallback desktop

[Install]
WantedBy=graphical.target
