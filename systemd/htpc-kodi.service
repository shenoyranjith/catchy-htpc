[Unit]
Description=CachyOS HTPC - Kodi session
After=systemd-user-sessions.service getty@tty1.service plymouth-quit-wait.service sound.target
Conflicts=getty@tty1.service htpc-steam.service htpc-desktop.service

[Service]
Type=simple
User=__HTPC_USER__
# Kodi's GBM windowing opens /dev/input/event* directly via libinput rather
# than acquiring them through logind's D-Bus device hand-off (the mechanism
# KDE/gamescope use), so it needs real group access to read them. Granted
# here rather than via a persistent usermod so it only applies to this
# session and is fully reverted by removing this unit.
SupplementaryGroups=input render
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=WINDOWING=gbm
ExecStart=/usr/bin/kodi-standalone
# Kodi's own "Exit" quits the whole process cleanly (exit 0); without this,
# that would strand the user on a blank tty1 with no running session.
# Restart=on-success relaunches Kodi in that case, but does not fight
# htpc-switch: a switch away stops this unit via systemctl, which systemd
# never subjects to Restart=, and a genuine crash (non-zero exit/signal) is
# left alone rather than restart-looping.
Restart=on-success

[Install]
WantedBy=graphical.target
