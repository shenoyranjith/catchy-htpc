[Unit]
Description=CachyOS HTPC - Steam Gaming Mode session
After=systemd-user-sessions.service getty@tty1.service plymouth-quit-wait.service sound.target
Conflicts=getty@tty1.service htpc-kodi.service htpc-desktop.service

[Service]
Type=simple
User=__HTPC_USER__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/start-gamescope-session
# Quitting Steam entirely (not via "Switch to Desktop", which goes through
# the steamos-session-select wrapper to htpc-switch instead) exits this
# process cleanly; Restart=on-success just relaunches Gaming Mode rather
# than stranding the user on a blank tty1. See htpc-kodi.service for why
# this doesn't conflict with htpc-switch's own stop/start calls.
Restart=on-success

[Install]
WantedBy=graphical.target
