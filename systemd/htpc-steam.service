[Unit]
Description=catchy-htpc - Steam Gaming Mode session
After=systemd-user-sessions.service getty@tty1.service plymouth-quit-wait.service sound.target
Conflicts=getty@tty1.service htpc-kodi.service htpc-desktop.service

[Service]
Type=simple
User=__HTPC_USER__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
# See htpc-kodi.service for why: avoids leaking a per-connection
# at-spi2-registryd instance (Steam's Qt-based UI is a known trigger).
Environment=NO_AT_BRIDGE=1
# Steam's pressure-vessel/bwrap needs to create user namespaces. Under a
# system unit without cgroup delegation that fails with:
#   "bwrap: Unexpected capabilities but not setuid"
#   "Steam now requires user namespaces to be enabled."
# Confirmed live on NVIDIA when launching via this unit; the same
# gamescope+steam command works from a normal user console (user.slice).
# Delegate=yes is the systemd-side fix for userns inside the service cgroup.
Delegate=yes
# htpc-steam-launch: AMD uses start-gamescope-session; NVIDIA uses a
# minimal `gamescope ... -- steam -steamdeck` (the full CachyOS session
# script broke the Deck UI on NVIDIA -- see bin/htpc-steam-launch).
ExecStart=/usr/local/bin/htpc-steam-launch
# Quitting Steam entirely (not via "Switch to Desktop", which goes through
# the steamos-session-select wrapper to htpc-switch instead), or a crash,
# falls back to Desktop rather than relaunching Gaming Mode or stranding
# the user on a blank tty1 -- matching the "If Steam fails: Attempt to
# start KDE Desktop" rule in session-lifecycle.md, and Kodi's own handling
# (see htpc-kodi.service and htpc_exit_fallback in htpc-switch for why
# Restart=no + ExecStopPost here doesn't fight htpc-switch's own stop/start
# calls during a deliberate switch away from Steam).
Restart=no
ExecStopPost=/usr/local/bin/htpc-switch --exit-fallback desktop

[Install]
WantedBy=graphical.target
