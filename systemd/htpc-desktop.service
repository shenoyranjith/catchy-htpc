[Unit]
Description=catchy-htpc - KDE Desktop session
After=systemd-user-sessions.service getty@tty1.service plymouth-quit-wait.service sound.target
Conflicts=getty@tty1.service htpc-kodi.service htpc-steam.service

[Service]
Type=simple
User=__HTPC_USER__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
# See htpc-kodi.service for why: avoids leaking a per-connection
# at-spi2-registryd instance. Desktop here is a maintenance/recovery
# workspace, not a daily driver, so screen-reader support is not a concern.
Environment=NO_AT_BRIDGE=1
ExecStart=/usr/bin/startplasma-wayland
Restart=no

[Install]
WantedBy=graphical.target
