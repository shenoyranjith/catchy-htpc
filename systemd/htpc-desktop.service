[Unit]
Description=catchy-htpc - KDE Desktop session
After=systemd-user-sessions.service getty@tty1.service plymouth-quit-wait.service sound.target
Conflicts=getty@tty1.service htpc-kodi.service htpc-steam.service

[Service]
Type=simple
User=__HTPC_USER__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
# See htpc-kodi.service for why: avoids leaking a per-connection
# at-spi2-registryd instance. Desktop here is a maintenance/recovery
# workspace, not a daily driver, so screen-reader support is not a concern.
Environment=NO_AT_BRIDGE=1
# Only meaningful on NVIDIA, where this unit also backs Steam Gaming Mode
# (nested gamescope Deck UI). Seeds HTPC_STEAM_BIGPICTURE on cold boot.
# The leading '-' ignores any failure rather than blocking Plasma.
ExecStartPre=-/usr/local/bin/htpc-steam-bigpicture-boot-marker
ExecStart=/usr/bin/startplasma-wayland
# Desktop exiting on its own (logging out, or a crash) enters Fatal Error
# (a plain getty on tty1) rather than relaunching Desktop or leaving a
# blank tty1 -- matching the "If KDE Desktop fails: Enter Fatal Error" rule
# in session-lifecycle.md. Unlike Kodi/Steam's exit-fallback, this is not
# "switch to another session" (Desktop is already the last resort); see
# the "fatal" pseudo-target in htpc_worker_main in htpc-switch.
Restart=no
ExecStopPost=/usr/local/bin/htpc-switch --exit-fallback fatal

[Install]
WantedBy=graphical.target
